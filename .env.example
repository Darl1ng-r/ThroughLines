# Supabase — from Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Production domain (no trailing slash)
VITE_APP_URL=https://yourdomain.com

# Google OAuth — from console.cloud.google.com → Credentials
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Supabase Edge Function URL for Redis cache proxy
VITE_REDIS_PROXY_URL=https://your-project.supabase.co/functions/v1/redis-proxy

# Sentry error tracking — from sentry.io → Project Settings → SDK Setup
# Leave blank to disable Sentry
VITE_SENTRY_DSN=
